# Node
node_modules/
**/node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage/

# Build output
dist/
build/
out/
.vite/
frontend/dist/
backend/dist/

# Environment files (sensitive)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# dotenv environment files
.envrc

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
Thumbs.db

# Mac specific
.AppleDouble
.LSOverride

# Temporary files
*.tmp
*.temp
~*~

# Database files
*.sqlite
*.sqlite3
*.db

# Secrets / keys
*.pem
*.key
*.crt
secrets.json

# Package manager locks (optional)
# If you want to track lockfiles (recommended), remove the following lines
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Test output
coverage/
nyc_output/

# Misc
.cache/
parcel-cache/
.sass-cache/

# Frontend / framework specific
/.nuxt/
/.next/
/.expo/
/.nuxt/

# Terraform
*.tfstate
*.tfstate.backup

# Other IDEs
*.idea/
*.project

# Windows image file cache
ehthumbs.db

# Ignore local MySQL/XAMPP config file if accidentally created
mysql/data/

# Ignore any local debug files
debug.log

# Keep any migration SQL in repo, but ignore local DB dumps by pattern
*.sql.dump
*.sql.gz

# Temporary VS Code workspace storage
.vscode/*storage*
